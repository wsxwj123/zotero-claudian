{
  "name": "zotero-claudian",
  "type": "module",
  "version": "0.1.32",
  "description": "Claude Code workbench inside Zotero 7/8/9",
  "config": {
    "addonName": "zotero-claudian",
    "addonID": "zotero-claudian@wsxwj123.github.io",
    "addonRef": "claudian",
    "addonInstance": "Claudian",
    "prefsPrefix": "extensions.zotero-claudian"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsxwj123/zotero-claudian.git"
  },
  "author": "wsxwj123",
  "bugs": {
    "url": "https://github.com/wsxwj123/zotero-claudian/issues"
  },
  "homepage": "https://github.com/wsxwj123/zotero-claudian#readme",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "node src/chat/build.mjs && zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12",
    "mermaid": "^11.17.2",
    "preact": "^10.29.8",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.4",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.2.2",
    "eslint": "^9.39.4",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.8",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
